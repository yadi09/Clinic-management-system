# ── Copy to .env (dev) and fill in. NEVER commit real secrets. ─────────────
# Environment: dev | staging | prod
APP_ENV=dev

# ── HTTP ──────────────────────────────────────────────────────────────────
API_HTTP_ADDR=:8080
# Comma-separated allowed CORS origins (dev SPA)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Base domain for tenant subdomain resolution (e.g. clinicos.app). Empty = disabled (use workspace field).
BASE_DOMAIN=
# Public web URL, used to build staff invite/accept links.
APP_BASE_URL=http://localhost:8088
# How long a staff invitation link stays valid.
INVITE_TTL=72h

# ── Database ──────────────────────────────────────────────────────────────
# Used by api, worker, migrate. In compose this points at the postgres service.
DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic?sslmode=disable
# Postgres SUPERUSER creds (compose only) — used to run migrations.
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
POSTGRES_DB=clinic
# Password for the least-privilege app login role (clinic_app) that api+worker
# use so Row-Level Security is enforced. Set at first DB init. openssl rand -hex 24
APP_DB_PASSWORD=dev-app-role-change-me

# ── Auth / JWT ────────────────────────────────────────────────────────────
# 32+ byte random secret for HS256 access tokens. Generate: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-please-32bytes-min-xxxxxxxx
JWT_ISSUER=clinicsaas
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Account lockout
MAX_FAILED_LOGINS=5
LOCKOUT_DURATION=15m
# Encryption key (32 bytes, base64) for at-rest TOTP secrets. openssl rand -base64 32
MFA_ENC_KEY=dev-only-change-me-base64-32-bytes-aaaaaaaaaaa=

# ── Storage (Cloudinary) — behind StorageProvider interface ─────────────────
# Leave blank in dev to use the no-op/local provider.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=clinic-dev

# ── Rate limiting (in-process token bucket) ─────────────────────────────────
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
