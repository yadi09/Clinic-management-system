{
	auto_https disable_redirects
}
:443 {
	tls /etc/caddy/origin.crt /etc/caddy/origin.key
	encode gzip zstd

	# Public partner-lead capture: let the static partner pages on clinicos.cc POST
	# same-origin to just this API path (evaluated before @marketing so it wins).
	@partnerapi {
		host clinicos.cc www.clinicos.cc
		path /api/v1/partner/*
	}
	handle @partnerapi {
		reverse_proxy api:8080
	}

	# Public marketing site — clinicos.cc (apex) and www
	@marketing host clinicos.cc www.clinicos.cc
	handle @marketing {
		root * /marketing
		try_files {path} {path}/ /index.html
		file_server
		header Cache-Control "public, max-age=300"
	}

	# The app — app.clinicos.cc (and direct-IP / anything else): SPA + API
	@api path /api/* /healthz /readyz /metrics
	handle @api {
		reverse_proxy api:8080
	}
	# Content-hashed build assets (their filename changes every build) can be cached
	# forever. A file that is NOT there is a 404 and is never cached: answering it with
	# the app page (as the catch-all below does for routes) made a browser holding an
	# older build see HTML where it expected a script, and labelled that HTML as
	# cacheable for a year (FE-6).
	handle /assets/* {
		root * /srv
		@found file {path}
		@missing not file {path}
		header @found Cache-Control "public, max-age=31536000, immutable"
		header @missing Cache-Control "no-store"
		file_server
	}
	handle {
		root * /srv
		# The app shell must always revalidate so a redeploy is picked up at once
		# instead of serving a stale, cached SPA.
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
